    "react-dom": "19.2.4",
    "react-email": "^4.0.13",
    "@react-email/components": "^0.0.36",
    "resend": "^4.5.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
